@page "{id}"
@model Razor_Pages_Testing.Pages.Users.ResetPasswordModel

<h1>Сброс пароля</h1>

<div class="row mt-3">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="InputModel.UserId" />

            <div class="mb-3">
                <label asp-for="InputModel.NewPassword" class="form-label"></label>
                <input asp-for="InputModel.NewPassword" class="form-control" />
                <span asp-validation-for="InputModel.NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-warning">Сбросить пароль</button>
                <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}