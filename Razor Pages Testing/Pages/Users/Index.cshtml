@page
@model Razor_Pages_Testing.Pages.Users.IndexModel

<h1>Список пользователей</h1>


<form asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post" class="d-inline">
    <button type="submit" class="btn btn-link text-dark">Выйти</button>
</form>


@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<table class="table table-striped table-hover table-bordered align-middle">
    <thead>
        <tr>
            <th>Имя пользователя</th>
            <th>Почта</th>
            <th>Возраст</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.Age</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@user.Id" class="btn btn-primary">Редактировать</a>
                    <form method="post" class="d-inline">
                        <button type="submit" asp-route-id="@user.Id" asp-page-handler="Delete" class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>