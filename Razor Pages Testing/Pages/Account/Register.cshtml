@page
@model Razor_Pages_Testing.Pages.Account.RegisterModel

<h1>Регистрация</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="InputModel.UserName" class="form-label"></label>
                <input asp-for="InputModel.UserName" class="form-control" />
                <span asp-validation-for="InputModel.UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InputModel.Email" class="form-label"></label>
                <input asp-for="InputModel.Email" class="form-control" />
                <span asp-validation-for="InputModel.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InputModel.Age" class="form-label"></label>
                <input asp-for="InputModel.Age" class="form-control" />
                <span asp-validation-for="InputModel.Age" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InputModel.Password" class="form-label"></label>
                <input asp-for="InputModel.Password" class="form-control" />
                <span asp-validation-for="InputModel.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InputModel.ConfirmPassword" class="form-label"></label>
                <input asp-for="InputModel.ConfirmPassword" class="form-control" />
                <span asp-validation-for="InputModel.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}