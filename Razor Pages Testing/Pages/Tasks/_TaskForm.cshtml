@model Razor_Pages_Testing.Models.UserTasks.InputUserTaskBase

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" type="text" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" />
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="mb-3 form-check">
    <label asp-for="IsDone" class="form-check-label"></label>
    <input asp-for="IsDone" type="checkbox" class="form-check-input" />
    <span asp-validation-for="IsDone" class="text-danger"></span>
</div>